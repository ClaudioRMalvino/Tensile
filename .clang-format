---

Language: Cpp
BasedOnStyle: Google

# Override the Google default of 2 spaces
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Prevent aggressive wrapping caused by the wider indentation
ColumnLimit: 120

# Google aligns to the type (e.g., int* ptr). Making it explicit:
PointerAlignment: Left

# Put function braces on their own line; everything else stays attached
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  SplitEmptyFunction: true

# Google allows `void foo() {}` on one line; this stops that
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortBlocksOnASingleLine: Always
---
