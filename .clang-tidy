---
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  google-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*

WarningsAsErrors: ""
HeaderFilterRegex: ".*"

# Tells clang-tidy to use your .clang-format file when applying automated fixes
FormatStyle: "file"
---
